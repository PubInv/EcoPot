FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    air
    {
        type triSurfaceMesh;
        file "air_fire.stl";

        regions
        {
            inlet	   { name inlet;     }
            outlet         { name outlet;    }
            walls          { name walls;     }
        }
    }

    solid
    {
        type triSurfaceMesh;
        file "wavy_pot_bud.stl";
    }
    
    lid
    {
        type triSurfaceMesh;
        file "conicalLid.stl";//"conicalLid_lifted.stl";
    }
    
    head
    {
        type triSurfaceMesh;
        file "headspace.stl";
    }
    
    water
    {
        type triSurfaceMesh;
        file "wavy_water_real.stl";
    }
};

castellatedMeshControls
{

    
    features
    (
        {
           file "air_fire.eMesh";
           levels ((2 3));
        }
       
        {
           file "wavy_pot_bud.eMesh";
           levels ((2 3));
        }
        
        {
           file "conicalLid.eMesh";//"conicalLid_lifted.eMesh";
           levels ((2 3));
        }
        
        {
           file "wavy_water_real.eMesh";
           levels ((2 3));
        }
        
        {
           file "headspace.eMesh";
           levels ((2 3));
        }
    );
    
    refinementSurfaces
    {
        air
        {
            level (0 0);
            regions
            {
                inlet     { level (0 0); patchInfo { type patch; } }
                outlet    { level (0 0); patchInfo { type patch; } }
                walls	  { level (0 0); patchInfo { type wall;  } }
            }
        }

        solid
        {
            level 	(2 5);
            faceZone 	solidToWater;
            cellZone 	solid;
            mode        insidePoint;
            insidePoint (0 0 1.5);
        }
        
        lid
        {
            level 	(2 5);
            faceZone 	lidToAir;
            cellZone 	lid;
            mode        insidePoint;
            insidePoint (0 0 43);//(0 0 44.5);
        }
        
        head
        {
            level 	(2 5);
            faceZone 	headToSolid;
            cellZone 	head;
            mode        insidePoint;
            insidePoint (0 0 39);
        }
        
        water
        {
            level 	(2 5);
            faceZone 	waterToSolid;
            cellZone 	water;
            mode        insidePoint;
            insidePoint (0 0 15);
        }

    }

    nCellsBetweenLevels 1;
    //nCellZoneErodeIter 3;
    resolveFeatureAngle 60;

    insidePoint (0 0 -10);
}

addLayersControls
{
    relativeSizes       true;
    minThickness        1;
    finalLayerThickness 1;
    expansionRatio      1;
    layers
    {}
}

